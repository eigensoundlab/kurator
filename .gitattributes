# Normalise line endings in the repository; scripts get the endings their OS needs.
* text=auto
*.sh  text eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf
*.png binary
*.jpg binary
*.webp binary
*.gif binary
*.ktx2 binary
*.exr binary
*.hdr binary
*.pdf binary
# vendored files stay byte-for-byte as built (their checksum is recorded)
kurator/static/js/vendor/*.mjs -text
