{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kurator",
  "mainBinaryName": "Kurator",
  "version": "0.19.0",
  "identifier": "com.eigensound.kurator",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; style-src 'self'; img-src 'self' data:; script-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "GraphicsAndDesign",
    "shortDescription": "Fast local asset manager",
    "longDescription": "Kurator finds, previews and tags pictures, textures, sounds, videos and 3D files on your own disks. This app is its window: it starts your installed Kurator and stops it when closed.",
    "publisher": "eigensound",
    "copyright": "sandner.art",
    "homepage": "https://github.com/eigensoundlab/kurator",
    "license": "Apache-2.0",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": { "installMode": "currentUser" }
    },
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  }
}
